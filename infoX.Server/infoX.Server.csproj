<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="infoX.Application\infoX.Application.csproj" />
    <ProjectReference Include="infoX.Infrastructure.Data\infoX.Infrastructure.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="infoX.Domain\**" />
    <Compile Remove="infoX.Application\**" />
    <Compile Remove="infoX.Infrastructure.Data\**" />
    <EmbeddedResource Remove="infoX.Domain\**" />
    <EmbeddedResource Remove="infoX.Application\**" />
    <EmbeddedResource Remove="infoX.Infrastructure.Data\**" />
    <None Remove="infoX.Domain\**" />
    <None Remove="infoX.Application\**" />
    <None Remove="infoX.Infrastructure.Data\**" />
</ItemGroup>
</Project>
